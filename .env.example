PORT=3000

# Environnement
NODE_ENV=production

# API key à passer dans le header x-api-key
# Générer une clé : node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
MAIL_API_KEY=your-api-key-here

# Brevo SMTP (récupérable dans SMTP & API > SMTP)
BREVO_API_KEY=your-brevo-smtp-key

MAIL_FROM="Facturly <no-reply@tondomaine.com>"

# Domaines email autorisés (optionnel, ex: "tondomaine.com,autre-domaine.com")
# Si vide, tous les domaines sont autorisés
ALLOWED_EMAIL_DOMAINS=
